# Copy to .env and adjust. Every value below is optional except when noted.

# --- server ---------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
# Public origin used in returned URLs. Empty = derive from the request.
# Set this when running behind a reverse proxy: https://pix.example.com
BASE_URL=
LOG_LEVEL=info
# Enable only behind Caddy/nginx, otherwise clients can spoof X-Forwarded-For.
TRUST_PROXY=false

# --- storage --------------------------------------------------------------
DATA_DIR=./data
STORAGE=local
# S3-compatible backend (only used when STORAGE=s3)
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PREFIX=images/
S3_USE_SSL=true

# --- image pipeline -------------------------------------------------------
# keep the untouched original alongside the optimised copy
KEEP_ORIGINAL=true
# preserve | jpeg | png | webp | avif
OUTPUT_FORMAT=webp
QUALITY=82
# longest edge in pixels, 0 = never resize
MAX_DIMENSION=2560
# strips EXIF/GPS before serving
STRIP_METADATA=true

# --- limits ---------------------------------------------------------------
MAX_FILE_MB=10
MAX_FILES_PER_UPLOAD=10
MAX_PIXELS=40000000

# --- abuse protection -----------------------------------------------------
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=200
RATE_LIMIT_PER_DAY=1000
AUTH_ATTEMPTS_PER_MINUTE=10
# Comma separated. Empty = no cross-origin API access at all.
ALLOWED_ORIGINS=
# Enables deleting any image with: Authorization: Bearer <token>
ADMIN_TOKEN=

# --- resize variants ------------------------------------------------------
# Allowed ?w= / ?h= values. Empty string = any value from 16..MAX_VARIANT_DIMENSION.
ALLOWED_SIZES=100,200,320,480,640,800,1200,1600,2000,2560
MAX_VARIANT_DIMENSION=4096
MAX_CONCURRENT_VARIANTS=1

# --- performance ----------------------------------------------------------
# libvips worker threads per image operation
VIPS_CONCURRENCY=1
MAX_CONCURRENT_UPLOADS=2
UPLOAD_QUEUE_LIMIT=32
ID_LENGTH=12
